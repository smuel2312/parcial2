# ---------------------------------------------------------------
# Parcial 2 - Variables de entorno
# Uso:  cp .env.example .env  &&  docker compose up -d
# ---------------------------------------------------------------

# --- PostgreSQL (servicio "database") ---
POSTGRES_DB=joomladb
POSTGRES_USER=joomlauser
POSTGRES_PASSWORD=joomlapassword
POSTGRES_HOST=database
POSTGRES_PORT=5432

# --- Joomla: instalación desatendida (Zero-Touch) ---
# La contraseña del administrador debe tener al menos 12 caracteres.
JOOMLA_SITE_NAME=Parcial2 Joomla
JOOMLA_ADMIN_USER=Administrador
JOOMLA_ADMIN_USERNAME=admin
JOOMLA_ADMIN_PASSWORD=AdminParcial2026!
JOOMLA_ADMIN_EMAIL=admin@parcial2.local
JOOMLA_DB_PREFIX=jos_

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin
